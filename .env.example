NODE_ENV=development
PORT=3000
SHOP_NAME=PP Queen
SHOP_PHONE=
SHOP_EMAIL=
SHOP_ADDRESS=
SHOP_FACEBOOK_URL=
SHOP_TELEGRAM_URL=
CURRENCY=$

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ppqueen
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=change-this-to-a-long-random-secret
ADMIN_NAME=PP Queen Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Telegram (either naming style is supported)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TG_TOKEN=
# TG_CHAT_ID=

# Permanent product image storage (Supabase Storage)
# Create a PUBLIC bucket named product-images in Supabase Storage.
# Keep the service-role key on the server only; never put it in frontend code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=product-images
